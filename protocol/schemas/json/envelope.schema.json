{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oncode.local/protocol/schemas/json/envelope.schema.json",
  "title": "onCode Tool Protocol Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "message_type", "message_id", "timestamp"],
  "properties": {
    "protocol": { "type": "string", "pattern": "^oncode-tool/[0-9]+\\.[0-9]+$" },
    "message_type": {
      "type": "string",
      "enum": ["REQUEST", "RESPONSE", "EVENT", "CANCEL", "ACK"]
    },
    "message_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string" },
    "project_id": { "type": "string" },
    "workspace_id": { "type": "string" },
    "workflow_id": { "type": "string" },
    "work_item_id": { "type": "string" },
    "task_id": { "type": "string" },
    "actor": {
      "type": "object",
      "required": ["type", "id"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["USER", "AGENT", "ORCHESTRATOR", "LOCAL_AGENT", "IDE", "SYSTEM"]
        },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "target": {
      "type": "object",
      "required": ["type", "id"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["TOOL"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "payload": { "type": "object" }
  }
}
