{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "out",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false
  },
  "include": [
    "extension/**/*.ts",
    "ipc/**/*.ts",
    "chat/**/*.ts",
    "progress/**/*.ts",
    "question/**/*.ts",
    "tests/**/*.ts"
  ]
}
